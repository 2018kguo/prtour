diff --git a/internal/native/codex.go b/internal/native/codex.go
new file mode 100644
index 0000000..0660f8f
--- /dev/null
+++ b/internal/native/codex.go
@@ -0,0 +1,200 @@
+package native
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/coder/websocket"
+)
+
+type codexRPC struct {
+	conn    *websocket.Conn
+	seq     int
+	peerPID int
+}
+
+func dialCodex(ctx context.Context, endpoint string) (*codexRPC, error) {
+	peer := 0
+	transport := &http.Transport{DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+		conn, err := (&net.Dialer{}).DialContext(ctx, "unix", endpoint)
+		if err != nil {
+			return nil, err
+		}
+		peer, err = peerPID(conn)
+		if err != nil {
+			conn.Close()
+			return nil, err
+		}
+		return conn, nil
+	}}
+	conn, response, err := websocket.Dial(ctx, "ws://localhost/rpc", &websocket.DialOptions{HTTPClient: &http.Client{Transport: transport}})
+	if response != nil && response.Body != nil {
+		defer response.Body.Close()
+	}
+	if err != nil {
+		transport.CloseIdleConnections()
+		return nil, fmt.Errorf("connect to the running Codex daemon: %w", err)
+	}
+	conn.SetReadLimit(maxOutput)
+	rpc := &codexRPC{conn: conn, peerPID: peer}
+	var init json.RawMessage
+	if err = rpc.call(ctx, "initialize", map[string]any{"clientInfo": map[string]string{"name": "ptyd", "version": "dev"}, "capabilities": map[string]bool{"experimentalApi": false}}, &init); err != nil {
+		conn.CloseNow()
+		return nil, err
+	}
+	if err = rpc.send(ctx, map[string]string{"method": "initialized"}); err != nil {
+		conn.CloseNow()
+		return nil, err
+	}
+	return rpc, nil
+}
+func (r *codexRPC) send(ctx context.Context, message any) error {
+	raw, err := json.Marshal(message)
+	if err != nil {
+		return err
+	}
+	return r.conn.Write(ctx, websocket.MessageText, raw)
+}
+func (r *codexRPC) call(ctx context.Context, method string, params, out any) error {
+	r.seq++
+	id := r.seq
+	if err := r.send(ctx, map[string]any{"id": id, "method": method, "params": params}); err != nil {
+		return err
+	}
+	for range 10000 {
+		kind, raw, err := r.conn.Read(ctx)
+		if err != nil {
+			return fmt.Errorf("Codex %s: %w", method, err)
+		}
+		if kind != websocket.MessageText {
+			return fmt.Errorf("Codex returned a non-JSON protocol message")
+		}
+		var envelope struct {
+			ID     json.RawMessage `json:"id"`
+			Result json.RawMessage `json:"result"`
+			Error  *struct {
+				Message string `json:"message"`
+			} `json:"error"`
+		}
+		if err = json.Unmarshal(raw, &envelope); err != nil {
+			return fmt.Errorf("decode Codex response: %w", err)
+		}
+		if len(envelope.ID) == 0 {
+			continue
+		}
+		var received int
+		if json.Unmarshal(envelope.ID, &received) != nil || received != id {
+			return fmt.Errorf("Codex returned an unexpected response id")
+		}
+		if envelope.Error != nil {
+			return fmt.Errorf("Codex %s: %s", method, envelope.Error.Message)
+		}
+		if len(envelope.Result) == 0 {
+			return fmt.Errorf("Codex %s has no result", method)
+		}
+		if err = json.Unmarshal(envelope.Result, out); err != nil {
+			return fmt.Errorf("decode Codex %s: %w", method, err)
+		}
+		return nil
+	}
+	return fmt.Errorf("Codex emitted too many unrelated messages; refresh discovery")
+}
+
+func codexSessions(ctx context.Context) ([]Session, bool, error) {
+	var daemon struct {
+		Status     string `json:"status"`
+		SocketPath string `json:"socketPath"`
+	}
+	if err := commandJSON(ctx, "codex", []string{"app-server", "daemon", "version"}, &daemon); err != nil {
+		return nil, false, err
+	}
+	if daemon.Status != "running" || !filepath.IsAbs(daemon.SocketPath) {
+		return nil, false, fmt.Errorf("Codex shared daemon is not running; open Codex normally before importing")
+	}
+	// Pin this daemon instance's protected socket. The public rendezvous symlink
+	// can change during an upgrade; import must not connect to a different worker.
+	endpoint, err := filepath.EvalSymlinks(daemon.SocketPath)
+	if err != nil {
+		return nil, false, err
+	}
+	stat, err := os.Stat(endpoint)
+	if err != nil {
+		return nil, false, err
+	}
+	if stat.Mode()&os.ModeSocket == 0 {
+		return nil, false, fmt.Errorf("Codex endpoint is not a Unix socket")
+	}
+	rpc, err := dialCodex(ctx, endpoint)
+	if err != nil {
+		return nil, false, err
+	}
+	defer rpc.conn.CloseNow()
+	var loaded struct {
+		Data []string `json:"data"`
+	}
+	if err = rpc.call(ctx, "thread/loaded/list", map[string]any{}, &loaded); err != nil {
+		return nil, false, err
+	}
+	truncated := len(loaded.Data) > maxSessions
+	ids := loaded.Data[:min(len(loaded.Data), maxSessions)]
+	out := make([]Session, 0, len(ids))
+	seen := map[string]bool{}
+	for _, id := range ids {
+		ref := Ref{Codex, id}
+		if ref.Validate() != nil {
+			return nil, false, fmt.Errorf("Codex reported an unsupported session id")
+		}
+		if seen[id] {
+			continue
+		}
+		seen[id] = true
+		var response struct {
+			Thread struct {
+				ID        string          `json:"id"`
+				Name      string          `json:"name"`
+				CWD       string          `json:"cwd"`
+				Source    json.RawMessage `json:"source"`
+				CreatedAt int64           `json:"createdAt"`
+				Status    struct {
+					Type        string   `json:"type"`
+					ActiveFlags []string `json:"activeFlags"`
+				} `json:"status"`
+			} `json:"thread"`
+		}
+		if err = rpc.call(ctx, "thread/read", map[string]any{"threadId": id, "includeTurns": false}, &response); err != nil {
+			return nil, false, err
+		}
+		t := response.Thread
+		if t.ID != id {
+			return nil, false, fmt.Errorf("Codex returned a different session than requested")
+		}
+		var source string
+		if json.Unmarshal(t.Source, &source) != nil {
+			continue
+		} // native subagents are not independent foreground sessions
+		if source != "cli" && source != "vscode" && source != "appServer" {
+			continue
+		}
+		s := Session{Ref: ref, Name: t.Name, CWD: t.CWD, Status: t.Status.Type, StartedAt: time.Unix(t.CreatedAt, 0), Endpoint: endpoint, WorkerPID: rpc.peerPID}
+		switch t.Status.Type {
+		case "idle", "active":
+			s.Action = Attach
+		default:
+			s.Action = Unavailable
+			s.Reason = "Codex has not confirmed a loaded, attachable session; open it in Codex and refresh."
+		}
+		if len(t.Status.ActiveFlags) > 0 {
+			s.Status = t.Status.ActiveFlags[0]
+			s.WaitingFor = strings.Join(t.Status.ActiveFlags, ", ")
+		}
+		out = append(out, s)
+	}
+	return out, truncated, nil
+}
diff --git a/internal/native/discover.go b/internal/native/discover.go
new file mode 100644
index 0000000..cf77c6f
--- /dev/null
+++ b/internal/native/discover.go
@@ -0,0 +1,191 @@
+package native
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"os/exec"
+	"regexp"
+	"sort"
+	"sync"
+	"time"
+)
+
+const maxSessions = 500
+const maxOutput = 4 << 20
+const timeout = 8 * time.Second
+
+var jobID = regexp.MustCompile(`^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$`)
+
+type Discoverer struct {
+	mu     sync.Mutex
+	cached Listing
+	at     time.Time
+}
+
+// List caches briefly so several overview clients do not spawn CLI probes on
+// every frame. Import uses Fresh and never authorizes from this cache.
+func (d *Discoverer) List(ctx context.Context) Listing {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if !d.at.IsZero() && time.Since(d.at) < 5*time.Second {
+		return d.cached
+	}
+	out := d.Fresh(ctx)
+	if ctx.Err() == nil {
+		d.cached = out
+		d.at = time.Now()
+	}
+	return out
+}
+func (d *Discoverer) Fresh(ctx context.Context) Listing {
+	out := Listing{Sessions: []Session{}, Issues: []Issue{}}
+	type result struct {
+		provider  Provider
+		sessions  []Session
+		truncated bool
+		err       error
+	}
+	ch := make(chan result, 2)
+	for _, p := range []Provider{Codex, Claude} {
+		go func() {
+			probe, cancel := context.WithTimeout(ctx, timeout)
+			defer cancel()
+			var r result
+			r.provider = p
+			if p == Codex {
+				r.sessions, r.truncated, r.err = codexSessions(probe)
+			} else {
+				r.sessions, r.truncated, r.err = claudeSessions(probe)
+			}
+			ch <- r
+		}()
+	}
+	for range 2 {
+		r := <-ch
+		if r.err != nil {
+			out.Issues = append(out.Issues, Issue{r.provider, r.err.Error()})
+		} else {
+			out.Sessions = append(out.Sessions, r.sessions...)
+		}
+		out.Truncated = out.Truncated || r.truncated
+		if r.truncated {
+			out.Issues = append(out.Issues, Issue{r.provider, "Native discovery omitted records; exact import is unavailable until a complete listing can be read."})
+		}
+	}
+	sort.Slice(out.Sessions, func(i, j int) bool { return out.Sessions[i].Ref.Key() < out.Sessions[j].Ref.Key() })
+	sort.Slice(out.Issues, func(i, j int) bool { return out.Issues[i].Provider < out.Issues[j].Provider })
+	return out
+}
+
+type cappedOutput struct{ bytes.Buffer }
+
+func (w *cappedOutput) Write(p []byte) (int, error) {
+	if len(p) > maxOutput-w.Len() {
+		return 0, fmt.Errorf("native response exceeds %d bytes", maxOutput)
+	}
+	return w.Buffer.Write(p)
+}
+func commandJSON(ctx context.Context, program string, args []string, out any) error {
+	cmd := exec.CommandContext(ctx, program, args...)
+	cmd.WaitDelay = time.Second
+	var stdout, stderr cappedOutput
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+	if err := cmd.Run(); err != nil {
+		return fmt.Errorf("%s query failed (%v); check that its CLI and native daemon are available", program, err)
+	}
+	if err := json.Unmarshal(stdout.Bytes(), out); err != nil {
+		return fmt.Errorf("%s returned an unsupported response: %w", program, err)
+	}
+	return nil
+}
+
+func claudeSessions(ctx context.Context) ([]Session, bool, error) {
+	var rows []struct {
+		CWD        string `json:"cwd"`
+		Kind       string `json:"kind"`
+		StartedAt  int64  `json:"startedAt"`
+		ID         string `json:"id"`
+		State      string `json:"state"`
+		PID        int    `json:"pid"`
+		Status     string `json:"status"`
+		WaitingFor string `json:"waitingFor"`
+		SessionID  string `json:"sessionId"`
+		Name       string `json:"name"`
+	}
+	if err := commandJSON(ctx, "claude", []string{"agents", "--json", "--all"}, &rows); err != nil {
+		return nil, false, err
+	}
+	truncated := len(rows) > maxSessions
+
+	out := make([]Session, 0, len(rows))
+	seen := map[string]bool{}
+	for _, r := range rows {
+		ref := Ref{Claude, r.SessionID}
+		if ref.Validate() != nil {
+			truncated = true
+			continue
+		}
+		s := Session{Ref: ref, Name: r.Name, CWD: r.CWD, Status: r.Status, WaitingFor: r.WaitingFor, WorkerPID: r.PID, StartedAt: time.UnixMilli(r.StartedAt), Handle: r.ID}
+		if s.Status == "" {
+			s.Status = r.State
+		}
+		switch r.Kind {
+		case "interactive":
+			s.Action = Background
+			s.Reason = "Run /bg in the original Claude tab, let its handoff finish, then refresh and import this session."
+		case "background":
+			if !jobID.MatchString(r.ID) {
+				s.Action = Unavailable
+				s.Reason = "Claude did not report a background job id; refresh after the handoff finishes."
+			} else if r.PID > 0 && (r.Status == "busy" || r.Status == "waiting" || r.Status == "idle") {
+				s.Action = Attach
+			} else if r.PID == 0 && (r.State == "done" || r.State == "failed" || r.State == "stopped") {
+				s.Action = Resume
+			} else {
+				s.Action = Unavailable
+				s.Reason = "Claude has not confirmed a live worker or a stopped conversation; refresh before importing."
+			}
+		default:
+			s.Action = Unavailable
+			s.Reason = "Claude reported an unsupported session kind; use its own agent view."
+		}
+		// A foreground record and its new background worker can coexist briefly.
+		// Fail closed during that handoff rather than choosing one by timestamp.
+		if seen[ref.Key()] {
+			for i := range out {
+				if out[i].Ref == ref {
+					out[i].Action = Unavailable
+					out[i].Reason = "Claude reports more than one worker for this conversation; finish the native handoff and refresh."
+				}
+			}
+			continue
+		}
+		seen[ref.Key()] = true
+		out = append(out, s)
+	}
+	return out[:min(len(out), maxSessions)], truncated || len(out) > maxSessions, nil
+}
+
+func (d *Discoverer) Lookup(ctx context.Context, ref Ref) (Session, error) {
+	if err := ref.Validate(); err != nil {
+		return Session{}, err
+	}
+	listing := d.Fresh(ctx)
+	for _, issue := range listing.Issues {
+		if issue.Provider == ref.Provider {
+			return Session{}, fmt.Errorf("%s: %s", issue.Provider, issue.Message)
+		}
+	}
+	for _, s := range listing.Sessions {
+		if s.Ref == ref {
+			return s, nil
+		}
+	}
+	if listing.Truncated {
+		return Session{}, fmt.Errorf("native listing was truncated; narrow the native session list and refresh")
+	}
+	return Session{}, fmt.Errorf("native session %s is no longer available; refresh discovery", ref.Key())
+}
