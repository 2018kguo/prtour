 		at.t.scrMu.Lock()
 		delete(at.t.attachers, at.a)
 		at.t.attached.Store(int32(len(at.t.attachers)))
+		closeNative := at.t.cfg.source.Provider != "" && len(at.t.attachers) == 0
+		if closeNative {
+			at.t.nativeClosing = true
+			if at.t.outputEnded && at.t.mgr != nil {
+				// EOF reaches the CLI before it reads the process exit status.
+				// Keep that result briefly instead of racing its GET with 404.
+				if at.t.nativeDeadline != nil {
+					at.t.nativeDeadline.Stop()
+				}
+				at.t.nativeDeadline = time.AfterFunc(time.Minute, func() { _ = at.t.mgr.Close(at.t.info.ID) })
+				closeNative = false
+			}
+		}
 		at.t.scrMu.Unlock()
 		if at.t.mgr != nil {
 			at.t.mgr.activeSubs.Add(-1)
+			if closeNative {
+				_ = at.t.mgr.Close(at.t.info.ID)
+			}
 		}
 	})
 }
@@ -302,3 +329,28 @@ func (t *terminal) endAttachers() {
 	t.attached.Store(0)
 	t.scrMu.Unlock()
 }
+
+// An abandoned import request must not leave a native frontend running forever.
+// The deadline ends once an attachment claims the view; last detach closes it.
+func (m *Manager) expireNativeView(id ID) {
+	t, err := m.get(id)
+	if err != nil {
+		return
+	}
+	t.scrMu.Lock()
+	defer t.scrMu.Unlock()
+	if t.cfg.source.Provider == "" || len(t.attachers) > 0 || t.nativeClosing {
+		return
+	}
+	t.nativeDeadline = time.AfterFunc(time.Minute, func() {
+		t.scrMu.Lock()
+		closeView := len(t.attachers) == 0 && !t.nativeClosing
+		if closeView {
+			t.nativeClosing = true
+		}
+		t.scrMu.Unlock()
+		if closeView {
+			_ = m.Close(id)
+		}
+	})
+}
diff --git a/internal/terminal/import.go b/internal/terminal/import.go
new file mode 100644
index 0000000..8b68848
--- /dev/null
+++ b/internal/terminal/import.go
@@ -0,0 +1,134 @@
+package terminal
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"time"
+	"unicode/utf8"
+
+	"github.com/2018kguo/ptyd/internal/native"
+)
+
+var ErrImportDeclined = errors.New("native import declined")
+
+type ImportRequest struct {
+	Ref    native.Ref `json:"ref"`
+	Name   string     `json:"name,omitempty"`
+	Resume bool       `json:"resume,omitempty"`
+	Cols   uint16     `json:"cols,omitempty"`
+	Rows   uint16     `json:"rows,omitempty"`
+}
+type ImportResult struct {
+	Terminal Info           `json:"terminal"`
+	Session  native.Session `json:"session"`
+	Reused   bool           `json:"reused"`
+}
+
+// NativeLookup bypasses the overview cache and resolves an exact conversation.
+type NativeLookup interface {
+	Lookup(context.Context, native.Ref) (native.Session, error)
+}
+
+// ImportAgent creates a terminal frontend for an existing native conversation.
+// Native workers remain owned by their daemon; closing this terminal only
+// closes its client. The source reference is part of the normal registry and
+// persistence, so import retries and daemon restarts do not invent a new owner.
+func (m *Manager) ImportAgent(ctx context.Context, lookup NativeLookup, req ImportRequest) (ImportResult, error) {
+	if err := req.Ref.Validate(); err != nil {
+		return ImportResult{}, fmt.Errorf("%w: %v", ErrImportDeclined, err)
+	}
+	m.importMu.Lock()
+	defer m.importMu.Unlock()
+	if err := ctx.Err(); err != nil {
+		return ImportResult{}, err
+	}
+	observed, err := lookup.Lookup(ctx, req.Ref)
+	if err != nil {
+		return ImportResult{}, fmt.Errorf("%w: %v", ErrImportDeclined, err)
+	}
+	if observed.Ref != req.Ref {
+		return ImportResult{}, fmt.Errorf("%w: native provider returned a different conversation", ErrImportDeclined)
+	}
+	var stopped []ID
+	for _, info := range m.List() {
+		if info.Source != req.Ref && !(info.Agent == string(req.Ref.Provider) && info.AgentSession == req.Ref.ID) {
+			continue
+		}
+		if info.Status == StatusRunning {
+			if info.Source.Provider != "" {
+				return ImportResult{}, fmt.Errorf("%w: imported window %s already exists; attach that window explicitly or close it first. Its original conversation is launch provenance, not a verified current input target", ErrImportDeclined, info.ID)
+			}
+			return ImportResult{Terminal: info, Session: observed, Reused: true}, nil
+		}
+		if info.Source.Provider != "" {
+			stopped = append(stopped, info.ID)
+		}
+	}
+	plan, err := native.Plan(observed, req.Resume)
+	if err != nil {
+		return ImportResult{}, fmt.Errorf("%w: %v", ErrImportDeclined, err)
+	}
+	identity := ""
+	if observed.WorkerPID > 0 {
+		identity, err = procIdentity(observed.WorkerPID)
+		if err != nil {
+			return ImportResult{}, fmt.Errorf("%w: cannot verify native worker: %v", ErrImportDeclined, err)
+		}
+	}
+	name := req.Name
+	if name == "" {
+		name = observed.Name
+	}
+	if name == "" {
+		name = string(req.Ref.Provider) + "-" + req.Ref.ID[:8]
+	}
+	for len(name) > maxNameLen {
+		_, n := utf8.DecodeLastRuneInString(name)
+		name = name[:len(name)-n]
+	}
+	if err = ctx.Err(); err != nil {
+		return ImportResult{}, err
+	}
+	info, err := m.Create(CreateConfig{Name: name, CWD: plan.CWD, Command: plan.Command, Args: plan.Args, Cols: req.Cols, Rows: req.Rows, Restore: RestoreNone, source: req.Ref})
+	if err != nil {
+		return ImportResult{}, err
+	}
+	// A successful fork/exec only confirms a frontend, not worker identity.
+	// Check the native authority again before reporting a live import. Never
+	// close the old tab or send input to make a handoff appear successful.
+	current, err := lookup.Lookup(ctx, req.Ref)
+	if err == nil && observed.Action == native.Resume {
+		confirmation, cancel := context.WithTimeout(ctx, 4*time.Second)
+		for err == nil && (current.Action != native.Attach || current.WorkerPID <= 0) {
+			select {
+			case <-confirmation.Done():
+				err = fmt.Errorf("native daemon has not confirmed the resumed worker; refresh discovery")
+			case <-time.After(100 * time.Millisecond):
+				current, err = lookup.Lookup(confirmation, req.Ref)
+			}
+		}
+		cancel()
+	}
+	if err == nil && (current.Ref != observed.Ref || current.CWD != observed.CWD || (observed.Action == native.Attach && (current.Action != native.Attach || current.WorkerPID != observed.WorkerPID || current.Endpoint != observed.Endpoint))) {
+		err = fmt.Errorf("native worker changed during import; refresh and try again")
+	}
+	if err == nil && current.WorkerPID > 0 {
+		after, e := procIdentity(current.WorkerPID)
+		if e != nil || (identity != "" && after != identity) {
+			err = fmt.Errorf("native process identity changed during import")
+		}
+	}
+	if err == nil {
+		err = ctx.Err()
+	}
+	if err != nil {
+		_ = m.Close(info.ID)
+		return ImportResult{}, fmt.Errorf("%w: %v", ErrImportDeclined, err)
+	}
+	m.expireNativeView(info.ID)
+	for _, id := range stopped {
+		_ = m.Close(id)
+	}
+	return ImportResult{Terminal: info, Session: current}, nil
+}
diff --git a/internal/terminal/import_test.go b/internal/terminal/import_test.go
new file mode 100644
index 0000000..70e9597
--- /dev/null
+++ b/internal/terminal/import_test.go
@@ -0,0 +1,330 @@
+package terminal
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/2018kguo/ptyd/internal/native"
+)
+
+const importFixtureID = "11111111-1111-4111-8111-111111111111"
+
+type nativeLookupFunc func(context.Context, native.Ref) (native.Session, error)
+
+func (f nativeLookupFunc) Lookup(ctx context.Context, r native.Ref) (native.Session, error) {
+	return f(ctx, r)
+}
+func importFixture(t *testing.T) (*Manager, native.Session, nativeLookupFunc, *os.Process) {
+	t.Helper()
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "claude"), []byte("#!/bin/sh\nprintf 'native frontend\\n'\nexec cat\n"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", dir+string(os.PathListSeparator)+os.Getenv("PATH"))
+	worker := exec.Command("sleep", "60")
+	if err := worker.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = worker.Process.Kill(); _ = worker.Wait() })
+	m := NewManagerWithOptions(Options{PersistDir: filepath.Join(dir, "state")})
+	t.Cleanup(m.CloseAll)
+	session := native.Session{Ref: native.Ref{Provider: native.Claude, ID: importFixtureID}, Name: "fixture", CWD: dir, Status: "busy", Action: native.Attach, WorkerPID: worker.Process.Pid, StartedAt: time.Now(), Handle: "job-fixture"}
+	lookup := nativeLookupFunc(func(ctx context.Context, r native.Ref) (native.Session, error) {
+		if err := ctx.Err(); err != nil {
+			return native.Session{}, err
+		}
+		if r != session.Ref {
+			return native.Session{}, fmt.Errorf("wrong ref")
+		}
+		return session, nil
+	})
+	return m, session, lookup, worker.Process
+}
+func assertWorkerAlive(t *testing.T, p *os.Process) {
+	t.Helper()
+	if err := p.Signal(syscall.Signal(0)); err != nil {
+		t.Fatalf("native worker was stopped: %v", err)
+	}
+}
+func TestImportCreatesAViewAndLastDetachKeepsNativeWorker(t *testing.T) {
+	m, session, lookup, worker := importFixture(t)
+	identity, _ := procIdentity(worker.Pid)
+	result, err := m.ImportAgent(context.Background(), lookup, ImportRequest{Ref: session.Ref})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Terminal.PID == worker.Pid || result.Terminal.Source != session.Ref || result.Reused {
+		t.Fatalf("wrong frontend identity: %+v", result)
+	}
+	a, err := m.Attach(result.Terminal.ID, 80, 24, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	a.Close()
+	a.Close()
