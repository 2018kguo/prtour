+		t.Fatal(err)
+	}
+	attachment, err := m.Attach(imported.Terminal.ID, 120, 40, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer attachment.Close()
+	for {
+		frame, e := m.Screen(imported.Terminal.ID, true)
+		if e != nil {
+			t.Fatal(e)
+		}
+		if strings.Contains(strings.Join(frame.Lines, "\n"), "Claude Code") {
