+func TestPaneStatusThemeWidthAndCaching(t *testing.T) {
+	for _, theme := range []struct{ name, fg, bg string }{{"dark", "#d8dee9", "#282c34"}, {"light", "#20252b", "#fafafa"}} {
+		for _, state := range []string{"attached", "viewing", "finished"} {
