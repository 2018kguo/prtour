+	"golang.org/x/term"
+)
+
+// Synthetic full-screen redraws model TUIs which repaint a scrolling transcript
+// between fixed header/composer rows. The host is an emulator, not a GPU/window:
+// this measures CPU, allocations and emitted bytes, not physical display latency.
+func paneScrollFrames(cols, rows int, direction int) [][]byte {
+	frames := make([][]byte, 64)
+	for i := range frames {
+		offset := i
+		if direction < 0 {
+			offset = len(frames) - i
+		}
+		b := []byte("\x1b[?2026h\x1b[H\x1b[0mAgent transcript\x1b[K\r\n\x1b[2K\r\n")
+		for y := 2; y < rows-3; y++ {
+			b = fmt.Appendf(b, "\x1b[0m\x1b[38;2;170;180;200m%06d \x1b[0mRead project files and check the working tree. \x1b[36m雪 👩‍💻\x1b[0m\x1b[K\r\n", offset+y)
+		}
+		b = append(b, "\x1b[48;2;60;64;72m\x1b[2K > Draft a reply\r\n\x1b[2K\x1b[0m\r\n\x1b[2K\x1b[?2026l"...)
+		frames[i] = b
+	}
+	return frames
+}
+
+// This local test process behaves like a mouse-driven TUI. No agent, model or
+// user's daemon is involved. Each wheel event redraws the transcript and marks
+// a new frame; the observer waits for its synchronized update to be complete.
+func TestPaneScrollWorker(t *testing.T) {
+	if os.Getenv("PTYD_SCROLL_WORKER") != "1" {
+		t.Skip("subprocess fixture")
+	}
+	state, err := term.MakeRaw(int(os.Stdin.Fd()))
+	if err != nil {
+		os.Exit(2)
+	}
+	defer term.Restore(int(os.Stdin.Fd()), state)
+	cols, rows, err := term.GetSize(int(os.Stdin.Fd()))
+	if err != nil {
+		os.Exit(3)
+	}
+	frames := paneScrollFrames(cols, rows, 1)
+	paint := func(i int) {
+		frame := bytes.Replace(frames[i%len(frames)], []byte("Agent transcript"), []byte(fmt.Sprintf("FRAME:%08d", i)), 1)
+		os.Stdout.Write(frame)
+	}
+	fmt.Print("\x1b[?1000h\x1b[?1006h")
+	paint(0)
+	reader := bufio.NewReader(os.Stdin)
+	for i := 1; ; i++ {
+		if _, err := reader.ReadBytes('M'); err != nil {
+			break
+		}
+		paint(i)
+	}
+	os.Exit(0)
+}
+
+// Keep the measurement fixture self-contained so the same *bench_test.go file
+// compiles against both revisions without changing their production/test code.
+type paneScrollProbe struct {
+	master, slave *os.File
+	mu            sync.Mutex
+	screen        *phosphor.Terminal
+	updated       chan struct{}
+}
+
+func waitScrollPaint(t testing.TB, u *paneScrollProbe, i int) {
+	t.Helper()
+	deadline := time.NewTimer(5 * time.Second)
+	defer deadline.Stop()
+	for {
+		u.mu.Lock()
+		painted := strings.HasPrefix(u.screen.Line(0), fmt.Sprintf("FRAME:%08d", i)) && !u.screen.Modes().SyncUpdate
+		u.mu.Unlock()
+		if painted {
+			return
+		}
+		select {
+		case <-u.updated:
+		case <-deadline.C:
+			t.Fatalf("scroll frame %d did not finish painting", i)
+		}
+	}
+}
+
+func scrollTerminal(t testing.TB, cols, rows int, framed bool) *paneScrollProbe {
+	t.Helper()
+	binary, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	master, slave, err := pty.Open()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := pty.Setsize(master, &pty.Winsize{Cols: uint16(cols), Rows: uint16(rows)}); err != nil {
+		master.Close()
+		slave.Close()
+		t.Fatal(err)
+	}
+	u := &paneScrollProbe{master: master, slave: slave, screen: phosphor.New(cols, rows), updated: make(chan struct{}, 1)}
+	go func() {
+		buf := make([]byte, 8192)
+		for {
+			n, err := master.Read(buf)
+			u.mu.Lock()
+			u.screen.Write(buf[:n])
+			u.mu.Unlock()
+			select {
+			case u.updated <- struct{}{}:
+			default:
+			}
+			if err != nil {
+				return
+			}
+		}
+	}()
+	t.Cleanup(func() { master.Close(); slave.Close() })
+	if !framed {
+		cmd := exec.Command(binary, "-test.run=^TestPaneScrollWorker$")
+		cmd.Env = append(os.Environ(), "PTYD_SCROLL_WORKER=1")
+		cmd.Stdin, cmd.Stdout, cmd.Stderr = u.slave, u.slave, u.slave
+		if err := cmd.Start(); err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { cmd.Process.Kill(); cmd.Wait() })
+	} else {
+		mgr := terminal.NewManager()
+		server := httptest.NewServer(api.New(mgr, api.Config{Token: "tok"}).Handler())
+		t.Cleanup(func() { mgr.CloseAll(); server.Close() })
+		addr := strings.TrimPrefix(server.URL, "http://")
+		info, err := mgr.Create(terminal.CreateConfig{Name: "scroll fixture", Command: binary, Args: []string{"-test.run=^TestPaneScrollWorker$"}, Cols: uint16(cols), Rows: uint16(rows - 1), Env: map[string]string{"PTYD_SCROLL_WORKER": "1"}})
+		if err != nil {
+			t.Fatal(err)
+		}
+		ctx, cancel := context.WithCancel(context.Background())
+		done := make(chan error, 1)
+		go func() {
+			_, err := Attach(ctx, Options{Addr: addr, Token: "tok", ID: string(info.ID), Label: "scroll witness"}, u.slave, u.slave, nil)
+			done <- err
+		}()
+		t.Cleanup(func() {
+			cancel()
+			select {
+			case err := <-done:
+				if err != nil {
+					t.Error(err)
+				}
+			case <-time.After(5 * time.Second):
+				t.Error("scroll attachment did not stop")
+			}
+		})
+	}
+	waitScrollPaint(t, u, 0)
+	return u
+}
+
+// Real local PTY input -> app -> (daemon/TCP/pane for framed) -> host emulator.
+// This includes batching and paint scheduling but excludes a GUI's GPU/display.
+// Direct and framed views give the app identical dimensions (the latter adds
+// the persistent status row). Sequential events model continuous scrolling.
+func BenchmarkAttachScrollLatency(b *testing.B) {
+	for _, size := range [][2]int{{120, 30}, {240, 64}} {
+		for _, framed := range []bool{false, true} {
+			b.Run(fmt.Sprintf("%dx%d/framed%t", size[0], size[1], framed), func(b *testing.B) {
+				rows := size[1] - 1
+				if framed {
+					rows++
+				}
+				u := scrollTerminal(b, size[0], rows, framed)
+				samples := make([]time.Duration, 0, b.N)
+				b.ResetTimer()
+				for i := 1; i <= b.N; i++ {
+					start := time.Now()
+					if _, err := u.master.Write([]byte("\x1b[<65;5;5M")); err != nil {
+						b.Fatal(err)
+					}
+					waitScrollPaint(b, u, i)
+					samples = append(samples, time.Since(start))
+				}
+				b.StopTimer()
+				slices.Sort(samples)
+				b.ReportMetric(float64(samples[len(samples)/2])/float64(time.Millisecond), "p50-ms")
+				b.ReportMetric(float64(samples[(len(samples)-1)*95/100])/float64(time.Millisecond), "p95-ms")
+			})
+		}
+	}
+}
+
+type paneBenchHost struct {
+	screen *phosphor.Terminal
+	bytes  int64
+}
+
+func (h *paneBenchHost) Write(b []byte) (int, error) {
+	h.bytes += int64(len(b))
+	return h.screen.Write(b)
+}
+
+func BenchmarkPaneScroll(b *testing.B) {
+	for _, size := range [][2]int{{120, 30}, {240, 64}} {
+		for _, direction := range []int{1, -1} {
+			name := fmt.Sprintf("%dx%d/direction%d", size[0], size[1], direction)
+			frames := paneScrollFrames(size[0], size[1]-1, direction)
+			b.Run(name+"/direct", func(b *testing.B) {
+				h := &paneBenchHost{screen: phosphor.New(size[0], size[1]-1)}
+				h.Write(frames[0])
+				h.bytes = 0
+				b.ReportAllocs()
+				b.ResetTimer()
+				for i := 0; i < b.N; i++ {
+					h.Write(frames[i%len(frames)])
+				}
+				b.StopTimer()
+				b.ReportMetric(float64(h.bytes)/float64(b.N), "wire-B/frame")
+			})
+			b.Run(name+"/framed", func(b *testing.B) {
+				h := &paneBenchHost{screen: phosphor.New(size[0], size[1])}
+				p := newPane(h, "group / agent", size[0], size[1])
+				p.Write(frames[0])
+				p.draw(false)
+				h.bytes = 0
+				b.ReportAllocs()
+				b.ResetTimer()
+				for i := 0; i < b.N; i++ {
+					p.Write(frames[i%len(frames)])
+					if err := p.draw(false); err != nil {
+						b.Fatal(err)
+					}
+				}
+				b.StopTimer()
+				b.ReportMetric(float64(h.bytes)/float64(b.N), "wire-B/frame")
+			})
+		}
+	}
+}
diff --git a/internal/client/pane_damage.go b/internal/client/pane_damage.go
new file mode 100644
index 0000000..a6519ed
--- /dev/null
+++ b/internal/client/pane_damage.go
@@ -0,0 +1,125 @@
+package client
+
+import (
+	"bytes"
+	"fmt"
+
+	"github.com/2018kguo/phosphor"
+)
+
+// Keep separate buffers for the last painted row and its replacement. Comparing
+// exact rendered bytes includes colors, hyperlinks and Unicode join modes.
+type paneRow struct {
+	previous, next []byte
+	changed        bool
+}
+
+func (r paneRow) current() []byte {
+	if r.changed {
+		return r.next
+	}
+	return r.previous
+}
+
+type paneScroll struct {
+	top, bottom, offset int // half-open region; positive offset scrolls up
+}
+
+func (s paneScroll) source(y int) int {
+	if y < s.top || y >= s.bottom {
+		return y
+	}
+	if source := y + s.offset; source >= s.top && source < s.bottom {
+		return source
+	}
+	return -1 // Newly exposed rows must be painted, including styled blanks.
+}
+
+func (p *pane) appendDamage(b []byte, view *phosphor.Terminal, force bool) []byte {
+	_, height := view.Size()
+	if len(p.painted) != height {
+		p.painted = make([]paneRow, height)
+		force = true
+	}
+	for y := range p.painted {
+		r := &p.painted[y]
+		r.changed = force || view.RowDirty(y)
+		if r.changed {
+			r.next = view.AppendRowANSI(r.next[:0], y)
+		}
+	}
+	var scroll paneScroll
+	if !force {
+		scroll = choosePaneScroll(p.painted)
+	}
+	if scroll.offset != 0 {
+		direction := 'S'
+		if scroll.offset < 0 {
+			direction = 'T'
+		}
+		b = fmt.Appendf(b, "\x1b[0m\x1b[%d;%dr\x1b[%d%c\x1b[r", scroll.top+1, scroll.bottom, max(scroll.offset, -scroll.offset), direction)
+	}
+	for y, r := range p.painted {
+		source := scroll.source(y)
+		if !force && source >= 0 && bytes.Equal(r.current(), p.painted[source].previous) {
+			continue
+		}
+		b = fmt.Appendf(b, "\x1b[%d;1H", y+1)
+		b = append(b, r.current()...)
+	}
+	for i := range p.painted {
+		r := &p.painted[i]
+		if r.changed {
+			r.previous, r.next = r.next, r.previous
+		}
+	}
+	return b
+}
+
+// Try small wheel/keyboard scrolls in both directions. An exact matching run
+// can move in the host terminal instead of retransmitting its rows. Limit the
+// search work, and only use a move when its total byte cost beats repainting.
+func choosePaneScroll(rows []paneRow) paneScroll {
+	best := paneScroll{}
+	bestCost := panePaintCost(rows, best)
+	if bestCost == 0 {
+		return best
+	}
+	for offset := -min(16, len(rows)-1); offset <= min(16, len(rows)-1); offset++ {
+		if offset == 0 {
+			continue
+		}
+		start, longest, length := 0, 0, 0
+		for y := max(-offset, 0); y < min(len(rows)-offset, len(rows)); y++ {
+			if bytes.Equal(rows[y].current(), rows[y+offset].previous) {
+				length++
+				if length > longest {
+					start, longest = y-length+1, length
+				}
+			} else {
+				length = 0
+			}
+		}
+		if longest < 3 {
+			continue
+		}
+		s := paneScroll{top: min(start, start+offset), bottom: max(start+longest, start+longest+offset), offset: offset}
+		// Covers region setup/reset and scroll command; row positions are a
+		// conservative fixed allowance rather than another serialization pass.
+		if cost := panePaintCost(rows, s) + 40; cost < bestCost {
+			best, bestCost = s, cost
+		}
+	}
+	return best
+}
+
+func panePaintCost(rows []paneRow, scroll paneScroll) int {
+	cost := 0
+	for y, row := range rows {
+		source := scroll.source(y)
+		if source < 0 || !bytes.Equal(row.current(), rows[source].previous) {
+			cost += len(row.current()) + 12
+		}
+	}
+	return cost
+}
diff --git a/internal/client/pane_test.go b/internal/client/pane_test.go
index 13fa0ea..3c80422 100644
--- a/internal/client/pane_test.go
+++ b/internal/client/pane_test.go
@@ -361,3 +361,104 @@ func TestFinishedPaneFlushesUnfinishedSynchronizedUpdate(t *testing.T) {
 		t.Fatalf("final error hidden: %q / %q", screen.Line(0), screen.Line(23))
 	}
 }
+
+func TestPaneScrollDamagePreservesRenderedState(t *testing.T) {
+	for _, width := range []int{40, 120} {
+		t.Run(strconv.Itoa(width), func(t *testing.T) {
+			var wire bytes.Buffer
+			p := newPane(&wire, "group / transcript", width, 24)
+			host := phosphor.New(width, 24, phosphor.WithScrollback(200))
+			check := func() {
+				t.Helper()
+				if err := p.draw(false); err != nil {
+					t.Fatal(err)
+				}
+				host.Write(wire.Bytes())
+				app := p.screen
+				cols, rows := app.Size()
+				for y := 0; y < rows; y++ {
+					for x := 0; x < cols; x++ {
+						want, got := app.Cell(x, y), host.Cell(x, y)
+						for _, c := range []*phosphor.Cell{&want, &got} {
+							if c.Rune == 0 && c.Width != 0 {
+								c.Rune = ' '
+							}
+						}
+						// Program palette changes are emitted as RGB, so compare the
+						// displayed colors as well as attributes and cluster structure.
+						for _, pair := range []struct {
+							cell    *phosphor.Cell
+							palette phosphor.Palette
+							reverse bool
+						}{{&want, app.Palette(), app.Modes().ReverseVideo}, {&got, host.Palette(), host.Modes().ReverseVideo}} {
+							fg, bg := pair.palette.Resolve(pair.cell.Style.Fg, false), pair.palette.Resolve(pair.cell.Style.Bg, true)
+							if (pair.cell.Style.Attrs&phosphor.AttrInverse != 0) != pair.reverse {
+								fg, bg = bg, fg
+							}
+							pair.cell.Style.Attrs &^= phosphor.AttrInverse
+							pair.cell.Style.Fg = phosphor.RGBColor(fg.R, fg.G, fg.B)
+							pair.cell.Style.Bg = phosphor.RGBColor(bg.R, bg.G, bg.B)
+						}
+						if want != got {
+							t.Fatalf("cell %d,%d: got %+v want %+v", x, y, got, want)
+						}
+					}
+				}
+				if want, got := app.Cursor(), host.Cursor(); want.X != got.X || want.Y != got.Y || want.Visible != got.Visible {
+					t.Fatalf("cursor got %+v want %+v", got, want)
+				}
+				if !strings.Contains(host.Line(rows), "jk: back") {
+					t.Fatal("scroll damaged the footer")
+				}
+			}
+			paint := func(offset int) {
+				var b strings.Builder
+				b.WriteString("\x1b[?2026h")
+				for y := 0; y < 23; y++ {
+					id := y + offset
+					if y < 2 || y >= 20 {
+						id = y
+					}
+					fmt.Fprintf(&b, "\x1b[%d;1H\x1b[0m\x1b[48;2;%d;30;40m\x1b[2K\x1b[4:3;31m", y+1, 20+id%20)
+					if id%5 != 0 {
+						fmt.Fprintf(&b, "\x1b]8;id=row%d;https://example.com/%d\x1b\\line %03d \x1b[?2027h雪 👩‍💻 é\x1b[?2027l\x1b]8;;\x1b\\", id, id, id)
+					}
+				}
+				b.WriteString("\x1b[0m\x1b[22;5H\x1b[?2026l")
+				p.Write([]byte(b.String()))
+			}
+			up, down := false, false
+			for _, offset := range []int{0, 1, 2, 5, 21, 5, 2, 1, 0, 1, 2} {
+				paint(offset)
+				check()
+				up = up || strings.Contains(wire.String(), "S\x1b[r")
+				down = down || strings.Contains(wire.String(), "T\x1b[r")
+				wire.Reset()
+			}
+			if !up || !down {
+				t.Fatal("fixture did not exercise scroll moves in both directions")
+			}
+			paint(2)
+			check()
+			if strings.Contains(wire.String(), "line ") || strings.Contains(wire.String(), "jk: back") {
+				t.Fatal("identical redraw retransmitted unchanged rows or footer")
+			}
+			wire.Reset()
+			saved := p.screen.Snapshot()
+			for _, write := range []string{"\x1b]4;1;#aabbcc\x1b\\", "\x1b[?1049h\x1b[2Jalternate", "\x1b[?1049l", "\x1b[?5h", "\x1b[?5l"} {
+				p.Write([]byte(write))
+				check()
+				wire.Reset()
+			}
+			if err := p.restore(saved); err != nil {
+				t.Fatal(err)
+			}
+			check()
+			wire.Reset()
+			p.resize(width+4, 26)
+			p.screen.Resize(width+4, 25)
+			host.Resize(width+4, 26)
+			check()
+		})
+	}
+}
